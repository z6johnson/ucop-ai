# LiteLLM (TritonAI) — the sole provider for /api/chat and the daily/
# weekly scan + digest scripts.
LITELLM_API_KEY=
# Optional override; defaults to https://tritonai-api.ucsd.edu
LITELLM_BASE_URL=

# Tier-2 web search runs through the LiteLLM `internet_tool` MCP server.
# Optional override; defaults to ${LITELLM_BASE_URL}/internet_tool/mcp (the
# PUBLIC gateway path). Do NOT point this at the cluster-internal upstream
# (…svc:8080/mcp) — that host isn't routable from CI. Auth reuses
# LITELLM_API_KEY via the `x-litellm-api-key: Bearer <key>` header.
LITELLM_MCP_URL=

# Interactive chat (/api/chat) is open-weight by default; only the paths
# that need Claude specifically (the weekly Brief, and anything using
# Anthropic's server-side web_search tool) fall back to CLAUDE_MODEL. Check
# https://tritonai-api.ucsd.edu/ui/model_hub_table/ for the current set of
# model IDs the proxy serves — a model can be pulled from the hub (as
# claude-sonnet-4-6 was) with no warning beyond a 403 at call time.
#
# Model used by chat. Defaults to api-glm-5.3 (open-weight).
CHAT_MODEL=api-glm-5.3

# Model used wherever Claude is specifically required (the Brief; the
# committee/monthly-enrichment web-search calls). Defaults to claude-sonnet-5.
CLAUDE_MODEL=claude-sonnet-5

# Admin gate for editing routes (e.g. /memos/new). Cookie is an HMAC
# keyed by this value, so rotating it invalidates every session.
ADMIN_PASSWORD=

# GitHub-as-CMS for memo publishing. POST /api/memos commits a markdown
# file to this repo; Vercel's Git integration rebuilds and publishes
# the memo (~60s).
# GITHUB_TOKEN: fine-grained PAT with Contents: Read and write on the
#   single repo below. No account permissions. Rotate on expiry.
# GITHUB_REPO: owner/repo target for the commit.
# GITHUB_BRANCH: optional, defaults to "main".
GITHUB_TOKEN=
GITHUB_REPO=z6johnson/ucnfi
GITHUB_BRANCH=main

# Postgres — planned for Step 3 (saved chats + shares). Not used yet.
DATABASE_URL=

# Public base URL for share links — added in Step 3
NFI_BASE_URL=http://localhost:3000
